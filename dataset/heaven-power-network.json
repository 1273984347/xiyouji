{
  "hierarchy": [
    {
      "key": "king",
      "name": "玉帝（帝王）",
      "tag": "JADE EMPEROR",
      "color": "#c8463a",
      "desc": "三界共主，居凌霄宝殿。掌天庭最高决策权，降旨调兵与封赏册封。名义统御三界，实质对佛道只能'请'不能'调'。",
      "examples": "玉皇大帝 · 王母娘娘"
    },
    {
      "key": "warrior",
      "name": "武将集团",
      "tag": "WARRIORS",
      "color": "#5a8a6a",
      "desc": "托塔天王李靖统兵，哪吒为先锋，二郎神听调不听宣。天蓬元帅与卷帘大将分掌水军与仪仗，巨灵神为门神。",
      "examples": "托塔天王李靖 · 哪吒 · 二郎神 · 天蓬元帅 · 卷帘大将 · 巨灵神"
    },
    {
      "key": "judge",
      "name": "文官体系",
      "tag": "CIVIL OFFICIALS",
      "color": "#c9a961",
      "desc": "太白金星为首席使臣，负责招安与外交。文曲星/武曲星辅佐朝政，月老掌姻缘。是天庭的行政与外交中枢。",
      "examples": "太白金星 · 文曲星 · 武曲星 · 月老"
    },
    {
      "key": "marginal",
      "name": "边缘星宿",
      "tag": "MARGINAL",
      "color": "#8a6a4a",
      "desc": "赤脚大仙闲散超然，风雨雷电四神司职自然，二十八星宿轮值护法。权力分散但职能专精，独立性较高。",
      "examples": "赤脚大仙 · 风神 · 雨神 · 雷公 · 电母 · 二十八星宿"
    },
    {
      "key": "buddha",
      "name": "佛门制衡",
      "tag": "BUDDHA",
      "color": "#b8902a",
      "desc": "如来佛祖虽非天庭臣属，却通过'玉帝请佛降妖'形成对天庭的宗教渗透。法力独立双满分，是天庭权力的重要外部制衡。",
      "examples": "如来佛祖"
    },
    {
      "key": "taoist",
      "name": "道家制衡",
      "tag": "TAOIST",
      "color": "#3a6b8c",
      "desc": "太上老君居兜率宫，炼丹炼宝。青牛精下凡需老君亲自收服，是天庭权力的重要道家制衡。",
      "examples": "太上老君"
    }
  ],
