  "timeline": [
    {
      "order": 1,
      "chapter": 8,
      "role": "招募者",
      "event": "盂兰盆会请缨",
      "desc": "如来立项，观音主动举手「弟子不才，愿上东土寻一个取经人来」"
    },
    {
      "order": 2,
      "chapter": 8,
      "role": "操盘手",
      "event": "组建取经团队",
      "desc": "五行山访悟空、福陵山收八戒、流沙河约沙僧，逐个招募成员"
    },
    {
      "order": 3,
      "chapter": 12,
      "role": "招募者",
      "event": "长安显圣点玄奘",
      "desc": "满朝文武前点名金蝉子转世，把唐太宗变成取经工程赞助人"
    },
    {
      "order": 4,
      "chapter": 14,
      "role": "约束者",
      "event": "紧箍儿发牌",
      "desc": "花帽藏紧箍骗悟空戴上，全书最温柔也最残忍的礼物"
    },
    {
      "order": 5,
      "chapter": 17,
      "role": "回收者",
      "event": "禁箍收黑熊精",
      "desc": "用禁箍儿套头收编守山大神，第一笔妖怪人才引进"
    },
    {
      "order": 6,
      "chapter": 26,
      "role": "调停者",
      "event": "柳枝甘露救树",
      "desc": "骂归骂帮归帮，救活人参果树，地仙系统不可得罪"
    },
    {
      "order": 7,
      "chapter": 39,
      "role": "回收者",
      "event": "金箍收红孩儿",
      "desc": "天罡刀穿双腿，最暴烈的降伏手段，收为善财童子"
    },
    {
      "order": 8,
      "chapter": 39,
      "role": "调停者",
      "event": "火云洞强行收编",
      "desc": "红孩儿战力太强背景太复杂，强行收编削弱牛魔王势力"
    },
    {
      "order": 9,
      "chapter": 46,
      "role": "回收者",
      "event": "竹篮回收金鱼",
      "desc": "编竹篮捞走莲花池金鱼，创造者回收造物，全书最「人」的时刻"
    },
    {
      "order": 10,
      "chapter": 46,
      "role": "调停者",
      "event": "通天河悄悄私了",
      "desc": "金鱼吃九年童男童女，竹篮捞走不公开审判，掩盖自身管理漏洞"
    },
    {
      "order": 11,
      "chapter": 56,
      "role": "退场者",
      "event": "紧箍咒废止",
      "desc": "六耳猕猴事件后玄奘不再念咒，外控系统被内控系统取代"
    },
    {
      "order": 12,
      "chapter": 74,
      "role": "退场者",
      "event": "灵山受封缺席",
      "desc": "不在灵山大殿、不在长安送别、不在凌云渡，回紫竹林种竹子"
    },
    {
      "order": 13,
      "chapter": 98,
      "role": "退场者",
      "event": "沉默退场归零",
      "desc": "从「掌握紧箍咒的菩萨」变成「种竹子的邻居」，连目送都省略"
    }
  ],
