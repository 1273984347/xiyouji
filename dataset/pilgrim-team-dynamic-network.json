  "phases": {
    "forming": {
      "name": "形成期 Forming",
      "range": "第 8-22 回 · 15 回",
      "feature": "观音装配团队，五人到位。成员对团队目标认知模糊（悟空=赎罪、八戒=误入、沙僧=脱罪）。表面形成，深层未形成。",
      "key_events": [
        "第 8 回 观音奉旨寻取经人",
        "第 14 回 五行山收悟空",
        "第 15 回 鹰愁涧收小白龙",
        "第 19 回 高老庄收八戒",
        "第 22 回 流沙河收沙僧"
      ]
    },
    "storming": {
      "name": "震荡期 Storming",
      "range": "第 22-59 回 · 38 回",
      "feature": "三次大冲突密集。每次冲突都是深层动机浮出水面。冲突不是团队失败的标志，而是团队建立信任的必经过程——但取经团队的震荡期过长，因缺乏监督评估者角色，冲突无法被冷静调解。",
      "key_events": [
        "第 14 回 杀六贼冲突",
        "第 27 回 三打白骨精冲突",
        "第 57-58 回 真假美猴王冲突"
      ]
    },
    "norming": {
      "name": "规范期 Norming",
      "range": "第 59-81 回 · 23 回",
      "feature": "角色边界清晰化。悟空不再挑战唐僧权威，唐僧不再轻易逐徒。但深层动机分化仍未解决——这是规范期的脆弱性。",
      "key_events": [
        "第 59-61 回 火焰山借扇",
        "第 65-66 回 小雷音寺",
        "第 75-77 回 狮驼岭"
      ]
    },
    "performing": {
      "name": "执行期 Performing",
      "range": "第 81-99 回 · 19 回",
      "feature": "团队从被动应对转向主动执行。但执行期的代价是角色固化——白龙马彻底沉默、沙僧彻底边缘化。高效以牺牲成员潜能实现。",
      "key_events": [
        "第 88 回 玉华州授徒",
        "第 93-95 回 天竺国玉兔",
        "第 98 回 凌云渡脱壳"
      ]
    },
    "adjourning": {
      "name": "解散期 Adjourning",
      "range": "第 100 回 · 1 回",
      "feature": "团队目标达成后立即解体。这是因为团队是任务导向（取经），非关系导向——任务完成，关系即解。",
      "key_events": [
        "第 100 回 五圣成真"
      ]
    }
  }
