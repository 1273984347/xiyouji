# 西游记项目环境变量模板
# 复制此文件为 .env 并填入实际值

# GitHub API
GITHUB_TOKEN=your_github_token_here

# 站点分析
ANALYTICS_ID=your_analytics_id_here

# RUM 后端
RUM_API_ENDPOINT=/api/rum

# 数据库（如使用）
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ---- 本地 RAG 后端（scripts/rag/，可选）----
# 留空则 RAG 走「检索上下文 + 渡口风格摘要」模式（零外部调用）；
# 填入后 xiyouji_rag.py / lightrag-hku 可走真实 LLM 生成。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-m3
