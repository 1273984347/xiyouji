# 西游·渡口 本地 RAG —— LLM 真实生成配置示例
#
# 复制为项目根 .env 或 scripts/rag/.env 后填入（两处都会自动加载，已有环境变量优先）。
# 未配置 LLM_API_KEY 时自动回退「渡口风格摘要」，不影响零依赖使用。
# 注意：.env 已被 .gitignore 忽略，key 不会进入版本库。

# —— 必填：LLM_API_KEY；LLM_MODEL 按 provider 填对应模型名 ——
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini

# —— provider 选择（决定原生端点与 API 格式）——
# 可选：openai | anthropic | glm | kimi | minimax | deepseek | dashscope
LLM_PROVIDER=openai

# —— 各 provider 专属 Base URL（可选·覆盖内置默认）——
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KIMI_BASE_URL=https://api.moonshot.cn/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# —— 自定义通用 Base URL（代理/网关模式）——
# 设置后优先于一切：统一按 OpenAI 兼容 /chat/completions 格式请求（网关约定）。
# 典型用途：OneAPI/NewAPI 等中转网关；或厂商 OpenAI 兼容端点（如 Azure OpenAI）。
CUSTOM_LLM_BASE_URL=

# —— 说明 ——
# 原生模式（未设 CUSTOM_LLM_BASE_URL）：anthropic 走原生 messages API（x-api-key 头），
#   其余 provider 走 OpenAI 兼容 /chat/completions（Bearer 头）。
# 代理模式（设 CUSTOM_LLM_BASE_URL）：统一 OpenAI 兼容格式——区分「代理」与「原生」。
# 模型名示例：deepseek-chat / glm-4-flash / moonshot-v1-8k / claude-3-5-sonnet-20241022 / qwen-plus
