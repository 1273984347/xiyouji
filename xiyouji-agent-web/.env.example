# CodeBuddy API 凭证（必填其一）
# 方式一：API Key（推荐）
CODEBUDDY_API_KEY=your_api_key_here
# 方式二：Auth Token（与 API Key 二选一）
# CODEBUDDY_AUTH_TOKEN=your_auth_token_here

# 后端服务端口（可选，默认 3000）
PORT=3000

# 适配项目的默认工作目录（可选，默认 D:/1/xiyouji）
# Agent 将以此为根目录读取 docs/、运行 scripts/、写入 dataset/ 等
PROJECT_CWD=D:/1/xiyouji

# 安全加固（W411 P0-1，可选）
# 1) 设置后所有 /api/* 需携带 x-agent-token 或 Authorization: Bearer <token>
# AGENT_WEB_TOKEN=your_token_here
# 2) 设 1 启用 bypassPermissions（本地单人模式）；默认关闭，外部请求体的 bypass 会被拒绝
# AGENT_WEB_ALLOW_BYPASS=1

# 可选：自定义 Base URL / 网络环境
# CODEBUDDY_BASE_URL=https://api.codebuddy.ai
# CODEBUDDY_INTERNET_ENVIRONMENT=external
