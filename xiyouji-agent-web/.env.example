# 引擎配置（W680 起）：OpenAI-compatible chat/completions 端点——兼容所有主流大模型
# 在服务端 .env 配置以下三项后重启生效（禁运行时覆盖，P0-2 同款纪律）
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_api_key_here
LLM_MODEL=glm-4.6
# 可选：逗号分隔的多模型列表（前端模型选择器；默认只有 LLM_MODEL）
# LLM_MODELS=glm-4.6,deepseek-chat,kimi-k2

# 主流端点 LLM_API_BASE 预设（均为 OpenAI-compatible 协议，任选其一）
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4
#   DeepSeek      https://api.deepseek.com
#   Kimi 月之暗面  https://api.moonshot.cn/v1
#   通义 Qwen     https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI        https://api.openai.com/v1
#   Gemini        https://generativelanguage.googleapis.com/v1beta/openai
#   Claude        https://api.anthropic.com/v1/（OpenAI SDK 兼容层）
#   ollama 本地    http://127.0.0.1:11434/v1
#   vLLM/LM Studio 自行按其 OpenAI-compatible 地址填写

# 后端服务端口（可选，默认 3000）
PORT=3000

# 项目工作目录（可选；默认向上探测 AGENTS.md + site/tokens.css 自动解析仓库根，无需手填）
# PROJECT_CWD=D:/xiyouji

# 安全加固（W411 P0-1，可选）
# 1) 设置后所有 /api/* 需携带 x-agent-token 或 Authorization: Bearer <token>
# AGENT_WEB_TOKEN=your_token_here
# 2) 设 1 启用 bypassPermissions（本地单人模式）；默认关闭，外部请求体的 bypass 会被拒绝
# AGENT_WEB_ALLOW_BYPASS=1
