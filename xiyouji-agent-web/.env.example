# 引擎配置（W680 起）：OpenAI-compatible chat/completions 端点——兼容所有主流大模型
# 在服务端 .env 配置以下三项后重启生效（禁运行时覆盖，P0-2 同款纪律）
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_api_key_here
LLM_MODEL=glm-4.6
# 可选：逗号分隔的多模型列表（前端模型选择器；默认只有 LLM_MODEL）
# LLM_MODELS=glm-4.6,deepseek-chat,kimi-k2

# 主流端点 LLM_API_BASE 预设（均为 OpenAI-compatible 协议，任选其一）
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4
#   DeepSeek      https://api.deepseek.com
#   Kimi 月之暗面  https://api.moonshot.cn/v1
#   通义 Qwen     https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI        https://api.openai.com/v1
#   Gemini        https://generativelanguage.googleapis.com/v1beta/openai
#   Claude        https://api.anthropic.com/v1/（OpenAI SDK 兼容层）
#   ollama 本地    http://127.0.0.1:11434/v1
#   vLLM/LM Studio 自行按其 OpenAI-compatible 地址填写

# 后端服务端口（可选，默认 3000）
PORT=3000

# 项目工作目录（可选；默认向上探测 AGENTS.md + site/tokens.css 自动解析仓库根，无需手填）
# PROJECT_CWD=D:/xiyouji

# 安全加固（W411 P0-1，可选）
# 1) 设置后所有 /api/* 需携带 x-agent-token 或 Authorization: Bearer <token>
#    W808：dev/preview server 会在**代理层**自动注入该头（token 不进浏览器包·不落 localStorage）；
#    前端直连后端（非代理）场景才需另设 VITE_AGENT_WEB_TOKEN（见下）。
# AGENT_WEB_TOKEN=your_token_here
# 2) 设 1 启用 bypassPermissions（本地单人模式）；默认关闭，外部请求体的 bypass 会被拒绝
# AGENT_WEB_ALLOW_BYPASS=1
# 3) W835：设 1 则**未设 token 时拒绝启动**（fail-closed·不静默降级为免认证）；
#    用于「对外暴露本机端口」等必须强制认证的部署形态
# AGENT_WEB_REQUIRE_TOKEN=1
# 4) W835：Host 头白名单（防 DNS rebinding）——默认只认回环三形态（127.0.0.1 / localhost / ::1），
#    此处为**追加**项（逗号分隔·主机名·不含端口）；如经反向代理以自有域名对外，请追加该域名。
#    判据只比主机名不比端口（dev proxy 会改写 Host 为代理目标、随机端口测试与桌面端同理）。
# AGENT_WEB_ALLOWED_HOSTS=your-host.example.com

# 前端环境变量（W808 新增·Vite 仅暴露 VITE_ 前缀的键给浏览器）
# 1) API 基址（可选；默认空串＝同源相对路径·走 Vite proxy）
#    后端与前端不同源部署时填绝对地址（如 http://127.0.0.1:3000）
# VITE_API_BASE_URL=http://127.0.0.1:3000
# 2) 共享 token（可选·仅在前端直连后端、绕过代理时才需要）
#    经代理时由 vite.config.ts 在服务端侧注入，浏览器不持有该值
# VITE_AGENT_WEB_TOKEN=your_token_here
# 3) 代理目标（可选·供 E2E 把 /api 代理指向测试实例端口；默认 http://localhost:3000）
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# 写操作审计（W752·默认开启，无需配置）
# 每条工具调用按 JSONL 追加到 xiyouji-agent-web/data/audit.jsonl（已 gitignore）；字段：
# ts / sessionId / tool / phase(permission|result) / decision(allow|deny) / kind / path|command / bytes / isError / reason。
# 只读回放端点（与其余 /api 同受 AGENT_WEB_TOKEN 保护）：GET /api/audit?limit=100（上限 1000）。
# 可用 AGENT_WEB_AUDIT_LOG 覆盖文件路径（相对路径按服务进程 cwd 解析）。
# 两条纪律：写入 fail-open——磁盘满/权限异常只 console.error，绝不让工具调用失败；
#           审计文件本身在工具层禁读（DENY_READ）——LLM 无法读回自己的操作史。
# AGENT_WEB_AUDIT_LOG=D:/tmp/audit.jsonl

# 细粒度写入允许域（W752·可选·默认不设＝保持原行为）
# 设置后 write_file/edit_file 仅允许落在这些前缀内（posix·逗号分隔·相对工作目录，默认工作目录=仓库根）：
#   AGENT_WEB_WRITE_SCOPE=docs/,site/,scripts/output/
# 语义：`docs/`=该目录下全部；`README.md`=该文件；`.`=全仓（等同不设）。
# 与受保护路径黑名单叠加：黑名单优先，白名单只收紧不放宽。
# 诚实说明：不设置时仍为「全工作目录可写」（W680 及以前行为，向后兼容）；
#           把 Agent 当文档助手用时建议收紧到 docs/,site/，可显著缩小一次误写的影响面。
# AGENT_WEB_WRITE_SCOPE=docs/,site/
