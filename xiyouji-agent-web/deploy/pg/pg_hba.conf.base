# ==============================================================================
# pg_hba.conf.base — PostgreSQL 16 认证基线（xiyouji 架构方案 v2 · D-1 批）
# ==============================================================================
# 用途：私有化部署的最小权限认证规则。
# 对应方案：§12.4 加密口径（服务端 ↔ PG 必须 TLS）· §12.2 缺口 2（默认免认证）
#          §10.2 私有化拓扑（应用层 2 副本 + 数据层 1 台）
#
# 用法（目标机）：
#   cp pg_hba.conf.base "$PGDATA/pg_hba.conf" && pg_ctl reload
#
# 纪律：
#   1) **口令禁写本文件**（用 .pgpass / 环境变量 / secret 挂载）。
#   2) 禁 trust（明文无认证）——除本机 postgres 维护通道。
#   3) 规则**从上到下首次匹配生效** ⇒ 顺序即语义，最具体的放最前。
#   4) 改本文件后必须重跑：python bin/verify-baseline.py（CI 同轨）。
# ==============================================================================

# TYPE    DATABASE   USER      ADDRESS          METHOD

# --- ① 本机维护通道（postgres 超级用户 · 仅本机 · 允许 peer/ident）--------------
# 用途：pg_ctl / pg_basebackup / 迁移脚本的本地运维通道。
# 禁 trust：peer 已是本机身份校验，无需明文口令。
local   all         postgres                        peer

# --- ② 容器/服务形态的本机通道（应用层若与 PG 同机跑容器）---------------------
# 说明：容器内以 TCP 连 127.0.0.1 时 local 规则不生效 ⇒ 需一条 127.0.0.1 规则。
# 该规则只放行本机回环，口令走 .pgpass / secret。
host    all         all         127.0.0.1/32     scram-sha-256
host    all         all         ::1/128          scram-sha-256

# --- ③ 应用层访问（内网网段 · 最先匹配 · 独立业务账号）-----------------------
# @@INTERNAL_CIDR@@ 由部署期注入（如 10.0.0.0/8）。
# 账号为业务角色（非超级用户）⇒ 即使口令泄露，权限面也被 §5.4 禁止依赖形态约束住。
host    xiyouji_app xiyouji_app @@INTERNAL_CIDR@@  scram-sha-256

# --- ④ 只读分析账号（内网网段 · 供报表/巡检只读访问）-------------------------
# §11.4 巡检清单的「每月恢复演练断言行数」与「季度复算」用只读账号即可。
host    xiyouji_app xiyouji_ro  @@INTERNAL_CIDR@@  scram-sha-256

# --- ⑤ 备份账号（仅本机 · 备份脚本用超级用户还是备份账号？）-------------------
# 备份需要读全部数据 ⇒ 用 postgres 角色的备份通道（local peer + 本机执行）。
# 禁给备份开远程 TCP：备份不跑在应用机上。
# （故不设远程 backup 规则）

# --- ⑥ 兜底：拒绝一切未显式放行的连接 -----------------------------------------
# 这一条是**安全底**：任何未被上面规则覆盖的来源一律拒绝。
# 保留 local replication / local all 的必要条目已在 ① 覆盖。
local   replication all                                  peer
host    replication all         127.0.0.1/32            scram-sha-256
host    all         all         0.0.0.0/0               reject
host    all         all         ::0/0                    reject
