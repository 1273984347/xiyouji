{
  "name": "xiyouji-agent-web",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "test:server": "node --import tsx --test server/engine/tools.test.ts server/audit.test.ts server/citationGuard.test.ts server/security.test.ts server/backup.test.ts server/metrics.test.ts",
    "test:integration": "node --import tsx --test server/api.integration.test.ts",
    "test:client": "vitest run",
    "test:e2e": "node e2e/chat.e2e.mjs",
    "test:all": "npm run test:server && npm run test:integration && npm run test:client",
    "smoke:engine": "node server/engine.smoke.mjs"
  },
  "dependencies": {
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tdesign-icons-react": "^0.6.11",
    "tdesign-react": "^1.18.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "cherry-markdown": "^0.11.9",
    "mermaid": "^11.16.1",
    "qs": "^6.16.0",
    "fast-uri": "^4.2.1",
    "proxy-addr": "^2.0.8",
    "shell-quote": "1.11.0",
    "katex": "^0.18.2"
  }
}
