      ],
      "genre": ["神魔小说", "古典小说", "章回体"],
      "description": "明代吴承恩所著百回神魔小说，叙唐僧师徒四人西天取经、历经九九八十一难的故事，是中国古典四大名著之一。",
      "hasPart": [
        { "@type": "Chapter", "position": 1, "name": "灵根育孕源流出 心性修持大道生" },
        { "@type": "Chapter", "position": 2, "name": "悟彻菩提真妙理 断魔归本合元神" },
        { "@type": "Chapter", "position": 3, "name": "四海千山皆拱伏 九幽十类尽除名" },
        { "@type": "Chapter", "position": 4, "name": "官封弼马心何足 名注齐天意未宁" },
        { "@type": "Chapter", "position": 5, "name": "乱蟠桃大圣偷丹 反天宫诸神捉怪" },
        { "@type": "Chapter", "position": 6, "name": "观音赴会问原因 小圣施威降大圣" },
        { "@type": "Chapter", "position": 7, "name": "八卦炉中逃大圣 五行山下定心猿" },
        { "@type": "Chapter", "position": 8, "name": "我佛造经传极乐 观音奉旨上长安" },
        { "@type": "Chapter", "position": 9, "name": "袁守诚妙算无私曲 老龙王拙计犯天条" },
        { "@type": "Chapter", "position": 10, "name": "二将军宫门镇鬼 唐太宗地府还魂" },
        { "@type": "Chapter", "position": 11, "name": "还受生唐王遵善果 度孤魂萧瑀正空门" },
        { "@type": "Chapter", "position": 12, "name": "玄奘秉诚建大会 观音显象化金蝉" },
        { "@type": "Chapter", "position": 13, "name": "陷虎穴金星解厄 双叉岭伯钦留僧" },
        { "@type": "Chapter", "position": 14, "name": "心猿归正 六贼无踪" },
        { "@type": "Chapter", "position": 15, "name": "蛇盘山诸神暗佑 鹰愁涧意马收缰" },
        { "@type": "Chapter", "position": 16, "name": "观音院僧谋宝贝 黑风山怪窃袈裟" },
        { "@type": "Chapter", "position": 17, "name": "孙行者大闹黑风山 观世音收伏熊罴怪" },
        { "@type": "Chapter", "position": 18, "name": "观音院唐僧脱难 高老庄行者降魔" },
        { "@type": "Chapter", "position": 19, "name": "云栈洞悟空收八戒 浮屠山玄奘受心经" },
        { "@type": "Chapter", "position": 20, "name": "黄风岭唐僧有难 半山中八戒争先" },
        { "@type": "Chapter", "position": 21, "name": "护法设庄留大圣 须弥灵吉定风魔" },
        { "@type": "Chapter", "position": 22, "name": "八戒大战流沙河 木叉奉法收悟净" },
        { "@type": "Chapter", "position": 23, "name": "三藏不忘本 四圣试禅心" },
        { "@type": "Chapter", "position": 24, "name": "万寿山大仙留故迹 五庄观行者窃人参" },
        { "@type": "Chapter", "position": 25, "name": "镇元仙赶捉取经僧 孙行者大闹五庄观" },
        { "@type": "Chapter", "position": 26, "name": "孙悟空三岛求方 观世音甘泉活树" },
        { "@type": "Chapter", "position": 27, "name": "尸魔三戏唐三藏 圣僧恨逐美猴王" },
        { "@type": "Chapter", "position": 28, "name": "花果山群妖聚义 黑松林三藏逢魔" },
        { "@type": "Chapter", "position": 29, "name": "脱难江流来国土 承恩八戒转山林" },
        { "@type": "Chapter", "position": 30, "name": "邪魔侵正法 意马忆心猿" },
        { "@type": "Chapter", "position": 31, "name": "猪八戒义激猴王 孙行者智降妖怪" },
        { "@type": "Chapter", "position": 32, "name": "平顶山功曹传信 莲花洞木母逢灾" },
        { "@type": "Chapter", "position": 33, "name": "外道迷真性 元神助本心" },
        { "@type": "Chapter", "position": 34, "name": "魔王巧算困心猿 大圣腾挪骗宝贝" },
        { "@type": "Chapter", "position": 35, "name": "外道施威欺正性 心猿获宝伏邪魔" },
        { "@type": "Chapter", "position": 36, "name": "心猿正处诸缘伏 劈破旁门见月明" },
        { "@type": "Chapter", "position": 37, "name": "鬼王夜谒唐三藏 悟空神化引婴儿" },
        { "@type": "Chapter", "position": 38, "name": "婴儿问母知邪正 金木参玄见假真" },
        { "@type": "Chapter", "position": 39, "name": "一粒金丹天上得 三年故主世间生" },
        { "@type": "Chapter", "position": 40, "name": "婴儿戏化禅心乱 猿马刀归木母空" },
        { "@type": "Chapter", "position": 41, "name": "心猿遭火败 木母被魔擒" },
        { "@type": "Chapter", "position": 42, "name": "大圣殷勤拜南海 观音慈善缚红孩" },
        { "@type": "Chapter", "position": 43, "name": "黑河妖孽擒僧去 西洋龙子捉鼍回" },
        { "@type": "Chapter", "position": 44, "name": "法身元运逢车力 心正妖邪度脊关" },
        { "@type": "Chapter", "position": 45, "name": "三清观大圣留名 车迟国猴王显法" },
        { "@type": "Chapter", "position": 46, "name": "外道弄强欺正法 心猿显圣灭诸邪" },
        { "@type": "Chapter", "position": 47, "name": "圣僧夜阻通天水 金木垂慈救小童" },
        { "@type": "Chapter", "position": 48, "name": "魔弄寒风飘大雪 僧思拜佛履层冰" },
        { "@type": "Chapter", "position": 49, "name": "三藏有灾沉水宅 观音救难现鱼篮" },
        { "@type": "Chapter", "position": 50, "name": "情乱性从因爱欲 神昏心动遇魔头" },
        { "@type": "Chapter", "position": 51, "name": "心猿空用千般计 水火无功难炼魔" },
        { "@type": "Chapter", "position": 52, "name": "悟空大闹金兜洞 如来暗示主人公" },
        { "@type": "Chapter", "position": 53, "name": "禅主吞餐怀鬼孕 黄婆运水解邪胎" },
        { "@type": "Chapter", "position": 54, "name": "法性西来逢女国 心猿定计脱烟花" },
        { "@type": "Chapter", "position": 55, "name": "色邪淫戏唐三藏 性正修持不坏身" },
        { "@type": "Chapter", "position": 56, "name": "神狂诛草寇 道昧放心猿" },
        { "@type": "Chapter", "position": 57, "name": "真行者落伽山诉苦 假猴王水帘洞誊文" },
        { "@type": "Chapter", "position": 58, "name": "二心搅乱大乾坤 一体难修真寂灭" },
        { "@type": "Chapter", "position": 59, "name": "唐三藏路阻火焰山 孙行者一调芭蕉扇" },
        { "@type": "Chapter", "position": 60, "name": "牛魔王罢战赴华筵 孙行者二调芭蕉扇" },
        { "@type": "Chapter", "position": 61, "name": "猪八戒助力败魔王 孙行者三调芭蕉扇" },
        { "@type": "Chapter", "position": 62, "name": "涤垢洗心惟扫塔 缚魔归正乃修身" },
        { "@type": "Chapter", "position": 63, "name": "二僧荡怪闹龙宫 群圣除邪获宝贝" },
        { "@type": "Chapter", "position": 64, "name": "荆棘岭悟能努力 木仙庵三藏谈诗" },
        { "@type": "Chapter", "position": 65, "name": "妖邪假设小雷音 四众皆遭大厄难" },
        { "@type": "Chapter", "position": 66, "name": "诸神遭毒手 弥勒缚妖魔" },
        { "@type": "Chapter", "position": 67, "name": "拯救驼罗禅性稳 脱离秽污道心清" },
        { "@type": "Chapter", "position": 68, "name": "朱紫国唐僧论前世 孙行者施为三折肱" },
        { "@type": "Chapter", "position": 69, "name": "心主夜间修药物 君王筵上论妖邪" },
        { "@type": "Chapter", "position": 70, "name": "妖魔宝放烟沙火 悟空计盗紫金铃" },
        { "@type": "Chapter", "position": 71, "name": "行者假名降怪犼 观音现象伏妖王" },
        { "@type": "Chapter", "position": 72, "name": "盘丝洞七情迷本 濯垢泉八戒忘形" },
        { "@type": "Chapter", "position": 73, "name": "情因旧恨生灾毒 心主遭魔幸破光" },
        { "@type": "Chapter", "position": 74, "name": "长庚传报魔头狠 行者施为变化能" },
        { "@type": "Chapter", "position": 75, "name": "心猿钻透阴阳窍 魔王还归大道真" },
        { "@type": "Chapter", "position": 76, "name": "心神居舍魔归性 木母同降怪体真" },
        { "@type": "Chapter", "position": 77, "name": "群魔欺本性 一体拜真如" },
        { "@type": "Chapter", "position": 78, "name": "比丘怜子遣阴神 金殿识魔谈道德" },
        { "@type": "Chapter", "position": 79, "name": "寻洞擒妖逢老寿 当朝正主救婴儿" },
        { "@type": "Chapter", "position": 80, "name": "姹女育阳求配偶 心猿护主识妖邪" },
        { "@type": "Chapter", "position": 81, "name": "镇海寺心猿知怪 黑松林三众寻师" },
        { "@type": "Chapter", "position": 82, "name": "姹女求阳 元神护道" },
        { "@type": "Chapter", "position": 83, "name": "心猿识得丹头 姹女还归本性" },
        { "@type": "Chapter", "position": 84, "name": "难灭伽持圆大觉 法王成正体天然" },
        { "@type": "Chapter", "position": 85, "name": "心猿妒木母 魔主计吞禅" },
        { "@type": "Chapter", "position": 86, "name": "木母助威征怪物 金公施法灭妖邪" },
        { "@type": "Chapter", "position": 87, "name": "凤仙郡冒天止雨 孙大圣劝善施霖" },
        { "@type": "Chapter", "position": 88, "name": "禅到玉华施法会 心猿木母授门人" },
        { "@type": "Chapter", "position": 89, "name": "黄狮精虚设钉钯宴 金木土计闹豹头山" },
        { "@type": "Chapter", "position": 90, "name": "师狮授受同归一 盗道缠禅静九灵" },
        { "@type": "Chapter", "position": 91, "name": "金平府元夜观灯 玄英洞唐僧供状" },
        { "@type": "Chapter", "position": 92, "name": "三僧大战青龙山 四星挟捉犀牛怪" },
        { "@type": "Chapter", "position": 93, "name": "给孤园问古谈因 天竺国朝王遇偶" },
        { "@type": "Chapter", "position": 94, "name": "四僧宴乐御花园 一怪空怀情欲喜" },
        { "@type": "Chapter", "position": 95, "name": "假合真形擒玉兔 真阴归正会灵元" },
        { "@type": "Chapter", "position": 96, "name": "寇员外喜待高僧 唐长老不贪富贵" },
        { "@type": "Chapter", "position": 97, "name": "金酬外护遭魔毒 圣显幽魂救本原" },
        { "@type": "Chapter", "position": 98, "name": "猿熟马驯方脱壳 功成行满见真如" },
        { "@type": "Chapter", "position": 99, "name": "九九数完魔刬尽 三三行满道归根" },
