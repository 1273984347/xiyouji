        { "@type": "Person", "name": "唐僧", "description": "金蝉子转世·取经团队首领" },
        { "@type": "Person", "name": "孙悟空", "description": "齐天大圣·取经团队护法" },
        { "@type": "Person", "name": "猪八戒", "description": "天蓬元帅转世·取经团队挑夫" },
